{
  "name": "frontend-logistica",
  "version": "0.0.0",
  "scripts": {
    "ng": "ng",
    "start": "ng serve",
    "build": "ng build",
    "watch": "ng build --watch --configuration development",
    "test": "ng test",
    "api:fetch": "node api/fetch-spec.mjs",
    "api:generate": "openapi-generator-cli generate -i api/openapi.json -g typescript-angular -o src/app/api -c api/generator-config.json --skip-validate-spec",
    "api:sync": "pnpm run api:fetch && pnpm run api:generate"
  },
  "private": true,
  "packageManager": "pnpm@11.3.0",
  "dependencies": {
    "@angular/common": "^22.1.0",
    "@angular/compiler": "^22.1.0",
    "@angular/core": "^22.1.0",
    "@angular/forms": "^22.1.0",
    "@angular/platform-browser": "^22.1.0",
    "@angular/router": "^22.1.0",
    "rxjs": "~7.8.0",
    "tslib": "^2.3.0"
  },
  "devDependencies": {
    "@angular/build": "^22.1.6",
    "@angular/cli": "^22.1.6",
    "@angular/compiler-cli": "^22.1.0",
    "@openapitools/openapi-generator-cli": "^2.41.0",
    "jsdom": "^28.0.0",
    "prettier": "^3.8.1",
    "typescript": "~6.0.2",
    "vitest": "^4.0.8"
  }
}
