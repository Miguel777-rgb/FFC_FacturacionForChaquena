# Los scripts de instalacion solo corren para los paquetes listados en
# pnpm.onlyBuiltDependencies de package.json. Es el equivalente al allowScripts
# que tenia npm, y la razon principal para estar en pnpm: un postinstall
# arbitrario de una dependencia transitiva no se ejecuta sin aprobarlo.
strict-peer-dependencies=false

# Angular y sus herramientas resuelven bien con el enlazado estricto de pnpm;
# dejarlo activado es lo que evita las dependencias fantasma (usar en el codigo
# un paquete que nunca se declaro, y que solo funcionaba porque npm lo aplanaba).
node-linker=isolated
