# Plantilla de configuracion. Copiar a .env y rellenar con valores reales:
#   cp .env.example .env
# El archivo .env esta ignorado por git y nunca debe versionarse.

# --- Base de datos (debe coincidir con compose.yml) ---
DB_URL=jdbc:postgresql://localhost:5432/logistica_db
DB_USERNAME=admin_logistica
DB_PASSWORD=cambiar-esta-password

# --- Postgres container (leido por docker compose) ---
POSTGRES_DB=logistica_db

# --- Mensajeria de los bots ---
# Que servicio externo transporta los dos bots: discord | whatsapp | ninguno.
# Discord es el canal en servicio; WhatsApp quedo apagado por el coste por
# conversacion de la Cloud API de Meta.
MENSAJERIA_PROVEEDOR=discord

# --- Discord ---
# Cada bot es una aplicacion propia en https://discord.com/developers/applications
#   1. New Application > Bot > Reset Token, y pega el token aqui.
#   2. En esa misma pantalla enciende Privileged Gateway Intents >
#      Message Content Intent. Sin eso el backend no arranca contra Discord.
#   3. OAuth2 > URL Generator: scopes "bot" y "applications.commands";
#      permisos "Send Messages", "Read Message History" y "Use Slash Commands".
#      Con esa URL invita cada bot a tu servidor.
#
# Bot IN: cuenta interna del personal (stock, comandas del mozo, cocina)
DISCORD_BOT_IN_TOKEN=
# Bot OUT: cuenta de cara al cliente (carta, pedidos, delivery, OTP)
DISCORD_BOT_OUT_TOKEN=

# Servidor donde registrar los comandos de barra. Activa el modo desarrollador
# en Discord (Ajustes > Avanzado) y copia el id con click derecho en el servidor.
# Sin este valor los comandos se registran globalmente y tardan hasta una hora
# en aparecer.
DISCORD_GUILD_ID=

# Canal donde se publican las comandas para cocina. Click derecho en el canal >
# Copiar id del canal. El bot IN tiene que poder escribir ahi.
DISCORD_CANAL_COCINA=

# --- WhatsApp Cloud API (solo con MENSAJERIA_PROVEEDOR=whatsapp) ---
# El adaptador sigue en el codigo y usa DOS numeros distintos dados de alta en
# Meta. Cada uno tiene su propio phone-number-id y su propio verify token.
WHATSAPP_API_URL=https://graph.facebook.com/v19.0

# Bot IN: numero interno del personal
WHATSAPP_BOT_IN_PHONE_NUMBER_ID=
WHATSAPP_BOT_IN_TOKEN=
WHATSAPP_BOT_IN_VERIFY_TOKEN=

# Bot OUT: numero de cara al cliente. Si el token se deja vacio se reutiliza el
# del Bot IN, que es lo habitual cuando ambos numeros estan en la misma app.
WHATSAPP_BOT_OUT_PHONE_NUMBER_ID=
WHATSAPP_BOT_OUT_TOKEN=
WHATSAPP_BOT_OUT_VERIFY_TOKEN=

# --- Google OAuth 2.0 ---
# Client id de la credencial en Google Cloud (APIs & Services > Credentials).
# OBLIGATORIO si se usa el inicio de sesion con Google: el backend compara este
# valor con la audiencia del token y, si esta vacio, rechaza todos los inicios
# con Google. El resto de la aplicacion funciona sin el.
GOOGLE_OAUTH_CLIENT_ID=

# --- Origenes del navegador (CORS) ---
# El dominio desde el que se abre la aplicacion, con esquema y sin barra final;
# varios separados por coma. En produccion es OBLIGATORIO: el navegador manda
# Origin en cada POST, aun contra su mismo origen, y sin este valor el backend
# responde "Invalid CORS request" al entrar. En local basta con dejarlo vacio.
CORS_ALLOWED_ORIGINS=

# --- Siembra ---
# SEED_ENABLED (true por defecto) siembra lo que el local necesita para
# funcionar: roles, permisos, cargos, las secciones de la carta y los alergenos.
# SEED_DEMO siembra ademas usuarios, comandas y stock de ejemplo, con una
# contrasena publicada en el repositorio: en un dominio abierto, cualquiera que
# lea el README entra como ADMIN. Enciendela solo mientras se muestra el
# sistema, y cambia la contrasena del administrador en cuanto termines.
SEED_ENABLED=true
SEED_DEMO=false

# --- Correo saliente (recuperar la contrasena) ---
# Solo se usa para el enlace de «olvide mi contrasena». El puerto 587 es
# STARTTLS: la conexion nace en claro y sube a cifrada antes de mandar el
# usuario y la clave. Con Gmail hay que usar una «contrasena de aplicacion»,
# no la del correo. Si SMTP_HOST se deja vacio, la aplicacion funciona igual y
# el envio solo queda anotado como fallido en el registro.
SMTP_HOST=
SMTP_PORT=587
SMTP_USUARIO=
SMTP_CLAVE=
# Solo para probar contra un recogedor de correo local, que no habla TLS. En el
# servidor se queda en true.
SMTP_STARTTLS=true
# Muchos proveedores exigen que el remitente coincida con la cuenta autenticada.
CORREO_REMITENTE=no-responder@chaquena.pe

# --- Recuperacion de contrasena ---
# La direccion publica del frontend: es la que se pega en el enlace del correo,
# asi que en el servidor tiene que ser el dominio de verdad, sin barra final.
RECUPERACION_URL_BASE=http://localhost:81
RECUPERACION_MINUTOS=30
RECUPERACION_MAX_POR_HORA=3

# --- JWT propio del backend (minimo 256 bits / 32 caracteres) ---
# Generar uno nuevo con: openssl rand -base64 48
JWT_SECRET=
JWT_EXPIRATION=86400000
